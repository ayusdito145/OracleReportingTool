            <MainSource>
              <DbSource ConnectionRef="OracleDBConnectionString (MySettings)" DbObjectName="OracleDB.dbo.v_sales_details" DbObjectType="View" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
 locationname, 
 businessdate,
 SUM(NetSales) AS netsales,
 SUM(TaxCollected) as taxcollected,
 SUM(NetSales) +  SUM(TaxCollected) AS total_rev,
 SUM(LessVAT) AS lessvat,
 SUM(LessPWD) AS lessPWD,
 SUM(LessSC) AS lessSC, 
SUM(lessEMP) AS lessEMP,
SUM(lessNationalAth) AS lessNtnlAth, 
SUM(lessSoloParent) AS lessSoloparent, 
SUM(CASE WHEN TRANSACTIONTYPE = 'Tender' THEN linetotal END) AS checkpaid, 
SUM(CASE WHEN VOIDFLAGTF = 'TRUE' THEN linetotal else 0 END) AS voidtotal,
SUM(CASE WHEN ordertypename = 'PWD' THEN netsales END) AS ordertype_pwd, 
SUM(CASE WHEN ordertypename = 'Senior Citizen' THEN netsales END) AS ordertype_sc,
SUM(CASE WHEN ordertypename = 'Standard' THEN netsales END) AS ordertype_standard,
SUM(CASE WHEN TRANSACTIONTYPE = 'Srvc Charge' THEN (linetotal) ELSE 0 END) AS srvc_amt,
SUM(CASE WHEN ordertypename in ('PWD','Senior Citizen') THEN netsales END) AS vatex,
SUM(CASE WHEN ordertypename in ('Zero Rated') THEN netsales else 0 END) AS zerorated,
SUM(CASE WHEN ordertypename in ('Standard') THEN netsales END) AS vat,
SUM(CASE WHEN DISCOUNTNAME NOT IN ('Employee Discount','Less: PWD Disc','Less: Sr Citizen Disc','Less: VAT','National Athlete') THEN ABS(LINETOTAL) END) as otherdiscount
FROM     v_sales_details

GROUP BY locationname,businessdate</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
