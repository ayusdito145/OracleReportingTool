          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dts_detailsTableAdapter" GeneratorDataComponentClassName="dts_detailsTableAdapter" Name="dts_details" UserDataComponentName="dts_detailsTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="OracleDBConnectionString (MySettings)" DbObjectName="OracleDB.dbo.dts_details" DbObjectType="Table" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT locationname, MAJORGROUPNAME, SUM(CASE WHEN TRANSACTIONTYPE = 'item Sale' THEN linecount ELSE 0 END) AS major_count, SUM(CASE WHEN TRANSACTIONTYPE = 'item Sale' THEN linetotal ELSE 0 END) AS gross_amt, 
                  ROUND(SUM(CASE WHEN TRANSACTIONTYPE = 'item Sale' THEN (LessVAT + LessSC + LessPWD + lessEMP + lessNationalAth) ELSE 0 END), 2) AS itemDiscount, 
                  SUM(CASE WHEN TRANSACTIONTYPE = 'item Sale' THEN linetotal ELSE 0 END) - SUM(CASE WHEN TRANSACTIONTYPE = 'item Sale' THEN (LessVAT + LessSC + LessPWD + lessEMP + lessNationalAth) ELSE 0 END) AS net_amt
FROM     dts_details
WHERE  (MAJORGROUPNAME IS NOT NULL) and GUESTCHECKID IN (
    SELECT DISTINCT GUESTCHECKID
    FROM dts_details
   WHERE TENDERNAME IN ('CASH','GRAB FOOD', 'FOOD PANDA','Debit Card', 'Master Card', 'QR PH', 'VISA', 'AMEX', 'JCB', 'Diners', 'BDO PAY', 'GC', 'SM Online Pay','UNION PAY', 'WECHAT','Botty Epay','GCASH'))
   and TRANSACTIONTYPE &lt;&gt; 'Other'
GROUP BY locationname, majorgroupname</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
