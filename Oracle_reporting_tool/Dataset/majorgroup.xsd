              <Mapping SourceColumn="locationname" DataSetColumn="locationname" />
              <Mapping SourceColumn="MAJORGROUPNAME" DataSetColumn="MAJORGROUPNAME" />
              <Mapping SourceColumn="major_count" DataSetColumn="major_count" />
              <Mapping SourceColumn="gross_amt" DataSetColumn="gross_amt" />
              <Mapping SourceColumn="itemDiscount" DataSetColumn="itemDiscount" />
              <Mapping SourceColumn="net_amt" DataSetColumn="net_amt" />
            </Mappings>
